{
  "enabled": true,
  "name": "Validate Roadmap",
  "description": "When ROADMAP.md is created or edited, cross-check it against VISION.md to ensure every business requirement is covered by at least one roadmap step, and no step references technology unavailable on ECC 7.5 EHP8 (CDS, AMDP, RAP, etc.).",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/ROADMAP.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Read the VISION.md in the same CHG folder as the ROADMAP.md that was just edited. Cross-check: (1) every business requirement in VISION.md has at least one corresponding roadmap step, (2) no roadmap step references CDS views, AMDP, RAP, EML, ABAP Cloud, or any tech unavailable on ECC 7.5 EHP8. Report any gaps or violations found. If everything aligns, confirm the roadmap covers the spec."
  },
  "workspaceFolderName": "sap-abap-mcp-workspace",
  "shortName": "validate-roadmap"
}